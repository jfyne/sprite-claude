<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#FF2B2B2B"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="4dp">

        <Button
            android:id="@+id/keyEsc"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ESC" />

        <Button
            android:id="@+id/keyTab"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TAB" />

        <Button
            android:id="@+id/keyCtrlC"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="^C" />

        <Button
            android:id="@+id/keyCtrlD"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="^D" />

        <Button
            android:id="@+id/keyCtrlZ"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="^Z" />

        <Button
            android:id="@+id/keyArrowUp"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↑" />

        <Button
            android:id="@+id/keyArrowDown"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="↓" />

        <Button
            android:id="@+id/keyArrowLeft"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←" />

        <Button
            android:id="@+id/keyArrowRight"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="→" />

        <Button
            android:id="@+id/keyPipe"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="|" />

        <Button
            android:id="@+id/keySlash"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="/" />

        <Button
            android:id="@+id/keyTilde"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="~" />

        <Button
            android:id="@+id/keyMinus"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="-" />

        <Button
            android:id="@+id/keyClear"
            style="@style/TerminalKeyButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CLR" />

    </LinearLayout>

</HorizontalScrollView>
